# CliniPulse Healthcare SaaS - Public Environment Variables
# Note: Keep private API keys, payment provider secrets, and WhatsApp tokens on the backend server!

VITE_APP_NAME="CliniPulse"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development" # "development" | "staging" | "production"
VITE_ENABLE_DEMO_MODE="true"

# Future Backend API Service Endpoints
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_AUTH_ENDPOINT="/auth"
VITE_CLINICS_ENDPOINT="/clinics"
VITE_APPOINTMENTS_ENDPOINT="/appointments"
VITE_PRESCRIPTIONS_ENDPOINT="/prescriptions"
VITE_VERIFICATION_ENDPOINT="/verify"
VITE_WHATSAPP_ENDPOINT="/notifications/whatsapp"
VITE_BILLING_ENDPOINT="/billing"

